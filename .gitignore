# macOS
.DS_Store
AB615685-*

# LoRA directories ship deployed artifacts (.safetensors, .ckpt) — source material is not tracked.
# Training datasets (lora-datasets/) are local-only per machine.
lora/**/*.jpg
lora/**/*.jpeg
lora/**/*.png
lora/**/*.webp
lora/**/*.txt
lora/**/*.sqlite3
lora/**/*.sqlite
lora/**/.DS_Store
lora/**/_raw/
lora/**/_pages/
lora-datasets/

# Local build/run artifacts
.source_files/
runs/

# Generated images live in R2 (cdn.slabgorb.com), not in this repo.
# Render scripts (scripts/generate_portrait_images.py, generate_poi_images.py,
# generate_creature_images.py) write PNGs into assets/images/<kind>/ as local
# workspace only; the canonical home is R2. r2_sync_packs.py uploads from here.
# Manifests (portrait_manifest.yaml, POI yaml files) ARE the spec and stay in git.
# Canonical layout: genre_packs/<pack>/assets/images/{portraits,poi,creatures,scenes}/
genre_packs/**/assets/images/portraits/*.png
genre_packs/**/assets/images/portraits/*.jpg
genre_packs/**/assets/images/portraits/*.webp
genre_packs/**/assets/images/poi/*.png
genre_packs/**/assets/images/poi/*.jpg
genre_packs/**/assets/images/poi/*.webp
genre_packs/**/assets/images/scenes/*.png
genre_packs/**/assets/images/scenes/*.jpg
genre_packs/**/assets/images/scenes/*.webp
genre_packs/**/assets/images/creatures/*.png
genre_packs/**/assets/images/creatures/*.jpg
genre_packs/**/assets/images/creatures/*.webp
# Legacy path patterns (kept for cross-clone compatibility — old local renders
# may still exist at the pre-consolidation images/ path on other machines)
genre_packs/**/images/portraits/*.png
genre_packs/**/images/portraits/*.jpg
genre_packs/**/images/portraits/*.webp
genre_packs/**/images/poi/*.png
genre_packs/**/images/poi/*.jpg
genre_packs/**/images/poi/*.webp
genre_packs/**/images/scenes/*.png
genre_packs/**/images/scenes/*.jpg
genre_packs/**/images/scenes/*.webp
genre_packs/**/images/creatures/*.png
genre_packs/**/images/creatures/*.jpg
genre_packs/**/images/creatures/*.webp
genre_packs/**/assets/poi/*.png
genre_packs/**/assets/poi/*.jpg
genre_packs/**/assets/poi/*.webp
genre_packs/**/assets/poi/*.zip
# World-level NPC portraits (Story 65-6) — parity with assets/poi/. The render
# script writes worlds/<world>/assets/portraits/<slug>.png; the binaries are
# R2-bound, the portrait_manifest.yaml spec stays in git.
genre_packs/**/assets/portraits/*.png
genre_packs/**/assets/portraits/*.jpg
genre_packs/**/assets/portraits/*.webp
# World-level creatures + scenes — parity with assets/portraits/ above. The
# render script writes worlds/<world>/assets/{creatures,scenes}/<slug>.png; the
# binaries are R2-bound (canonical), the manifest/spec stays in git. Without
# these rules world-level creature PNGs leak into commits (caught 2026-06-06).
genre_packs/**/assets/creatures/*.png
genre_packs/**/assets/creatures/*.jpg
genre_packs/**/assets/creatures/*.webp
genre_packs/**/assets/scenes/*.png
genre_packs/**/assets/scenes/*.jpg
genre_packs/**/assets/scenes/*.webp
genre_packs/**/worlds/*/rooms/*.cavern.png
genre_packs/**/worlds/*/rooms/*.png
genre_packs/**/worlds/*/rooms/*.jpg
genre_packs/**/worlds/*/rooms/*.webp

# Purchased / generated audio lives in R2 (cdn.slabgorb.com), not in this repo
# — same policy as the images above (ADR-095). The audio.yaml manifests and
# audio/music/*_input_params.json specs ARE tracked; the .ogg binaries are
# R2-bound and uploaded via scripts/r2_sync_packs.py.
genre_packs/**/audio/**/*.ogg

# Procedurally-materialized room YAMLs (ADR-106 megadungeon expansion output) —
# canonical state lives in the save db; on-disk files are runtime artifacts.
genre_packs/**/worlds/*/rooms/*.yaml
# Exception: authored entrance rooms (expansion 0 seed; materializer never emits these)
!genre_packs/**/worlds/*/rooms/entrance.yaml

# Commercial sound library (licensed, not redistributable) — symlinked out of repo
sound_effects
.playtest-screenshots/

# Local agent scratch
.claude/
